# SnapFrame capture and motion-analysis configuration
# Copy to <game-directory>/port/snapframe.conf
enabled=1
multiplier=2
quality=1
flow_scale_percent=50
motion_analysis=1
profiling_enabled=1
diagnostic_suite=0
# 1800 frames ~= 30s at 60 FPS or 60s at 30 FPS
diagnostic_phase_frames=1800

# profiling_enabled=1 writes:
#   port/snapframe_gpu.csv          GPU timestamps every 30 captured frames
#   port/snapframe_flow.csv         aggregate flow/mask readback every 120 flow pairs during diagnostic suite
#   port/snapframe_flow_vectors.csv spatial vectors every 600 flow pairs during diagnostic suite
#   port/snapframe_events.csv      per-frame capture/compute/skip event timeline
# Set profiling_enabled=0 to disable timestamp queries and all diagnostic readback.

# motion_analysis=1 enables the complete experimental GPU path: luma, bidirectional
# flow, consistency, midpoint reconstruction and one additional WSI present.
# Set motion_analysis=0 to keep capture-only diagnostics.
# diagnostic_suite=1 runs the seven-phase motion-analysis test and therefore requires motion_analysis=1.
# profiling_enabled is independent: it controls GPU timestamps and diagnostic readback only.
# flow_scale_percent changes the motion-grid density (lower values use a coarser grid).
