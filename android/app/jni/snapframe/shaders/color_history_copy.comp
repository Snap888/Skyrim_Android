#version 450

// Preserve the real source frame in linear RGBA16F for temporal midpoint warp.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D sourceColor;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D historyColor;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(historyColor);
    if (any(greaterThanEqual(p, extent)))
        return;
    imageStore(historyColor, p, texelFetch(sourceColor, p, 0));
}
