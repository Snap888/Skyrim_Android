#version 450

// Coarse block-matching motion field over half-resolution luma.
// One output texel represents an 8x8 luma region (16x16 source pixels).
// Motion is expressed in half-resolution luma texels. The host runs this
// kernel twice with reversed inputs: current->previous, then previous->current.
// Confidence is local best/second-best SAD separation, not FB consistency.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D previousLuma;
layout(set = 0, binding = 1) uniform sampler2D currentLuma;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D motionOutput;

float lumaAt(sampler2D image, ivec2 p) {
    return texelFetch(image, p, 0).r;
}

void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outExtent = imageSize(motionOutput);
    if (any(greaterThanEqual(outPos, outExtent)))
        return;

    ivec2 extent = textureSize(currentLuma, 0);
    // Keep the current 3x3 patch fully inside the image. Candidate patches
    // outside the previous frame are rejected instead of edge-clamped.
    if (any(lessThan(extent, ivec2(3)))) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    ivec2 center = min(outPos * 8 + ivec2(4), extent - ivec2(2));
    const int searchRadius = 4;
    const int patchRadius = 1;

    float bestCost = 1.0e20;
    float secondCost = 1.0e20;
    ivec2 bestMotion = ivec2(0);
    int bestMotionDistanceSquared = 0x7fffffff;

    for (int dy = -searchRadius; dy <= searchRadius; ++dy) {
        for (int dx = -searchRadius; dx <= searchRadius; ++dx) {
            ivec2 motion = ivec2(dx, dy);
            float cost = 0.0;
            bool valid = true;

            for (int py = -patchRadius; py <= patchRadius; ++py) {
                for (int px = -patchRadius; px <= patchRadius; ++px) {
                    ivec2 samplePos = center + ivec2(px, py);
                    ivec2 previousPos = samplePos + motion;
                    if (any(lessThan(previousPos, ivec2(0)))
                     || any(greaterThanEqual(previousPos, extent))) {
                        valid = false;
                        break;
                    }
                    float a = lumaAt(currentLuma, samplePos);
                    float b = lumaAt(previousLuma, previousPos);
                    cost += abs(a - b);
                }
                if (!valid)
                    break;
            }

            if (!valid)
                continue;

            if (cost < bestCost) {
                secondCost = bestCost;
                bestCost = cost;
                bestMotion = motion;
                bestMotionDistanceSquared = dx * dx + dy * dy;
            } else if (cost == bestCost) {
                // Equal-cost matches are ambiguous. Prefer the smallest
                // displacement (zero motion wins on flat/low-texture blocks)
                // instead of retaining the first search candidate (-4,-4).
                secondCost = bestCost;
                int motionDistanceSquared = dx * dx + dy * dy;
                if (motionDistanceSquared < bestMotionDistanceSquared) {
                    bestMotion = motion;
                    bestMotionDistanceSquared = motionDistanceSquared;
                }
            } else if (cost < secondCost) {
                secondCost = cost;
            }
        }
    }

    if (bestCost >= 1.0e19) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    float confidence = clamp(
        (secondCost - bestCost) / max(secondCost, 1.0e-5), 0.0, 1.0);
    imageStore(motionOutput, outPos,
        vec4(vec2(bestMotion), confidence, bestCost / 9.0));
}
