#version 450
// Coarse-to-fine block-matching motion field over half-resolution luma.
// One output texel represents a configurable luma region. At 100% flow scale
// it is 8x8 luma texels; lower scales increase the stride and reduce the grid.
// Motion is expressed in half-resolution luma texels. The host runs this
// kernel twice with reversed inputs: current->previous, then previous->current.
// Confidence is local best/second-best SAD separation, not FB consistency.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D previousLuma;
layout(set = 0, binding = 1) uniform sampler2D currentLuma;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D motionOutput;
const ivec2 kPatchOffsets[9] = ivec2[9](
    ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0),
    ivec2(0, -1), ivec2(0, 1), ivec2(-1, -1),
    ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1));
void evaluateCandidate(
    ivec2 motion, ivec2 center, ivec2 extent,
    const float currentPatch[9],
    inout float bestCost, inout float secondCost,
    inout ivec2 bestMotion, inout int bestMotionDistanceSquared) {
    float cost = 0.0;
    // Reuse the invariant current-frame patch; fetch only displaced previous luma.
    for (int sampleIndex = 0; sampleIndex < 9; ++sampleIndex) {
        ivec2 previousPos = center + kPatchOffsets[sampleIndex] + motion;
        if (any(lessThan(previousPos, ivec2(0))) ||
            any(greaterThanEqual(previousPos, extent)))
            return;
        cost += abs(currentPatch[sampleIndex] -
                    texelFetch(previousLuma, previousPos, 0).r);
        // Exact monotonic SAD early-out: a candidate above second-best cannot win.
        if (cost > secondCost)
            return;
    }
    int distanceSquared = motion.x * motion.x + motion.y * motion.y;
    if (cost < bestCost) {
        secondCost = bestCost; bestCost = cost;
        bestMotion = motion; bestMotionDistanceSquared = distanceSquared;
    } else if (cost == bestCost) {
        secondCost = bestCost;
        if (distanceSquared < bestMotionDistanceSquared) {
            bestMotion = motion; bestMotionDistanceSquared = distanceSquared;
        }
    } else if (cost < secondCost) {
        secondCost = cost;
    }
}
void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outExtent = imageSize(motionOutput);
    if (any(greaterThanEqual(outPos, outExtent))) return;
    ivec2 extent = textureSize(currentLuma, 0);
    if (any(lessThan(extent, ivec2(3)))) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    ivec2 blockStride = max(ivec2(1),
        ivec2(ceil(vec2(extent) / vec2(outExtent))));
    ivec2 center = min(outPos * blockStride + blockStride / 2,
                       extent - ivec2(2));
    float currentPatch[9];
    for (int sampleIndex = 0; sampleIndex < 9; ++sampleIndex)
        currentPatch[sampleIndex] =
            texelFetch(currentLuma, center + kPatchOffsets[sampleIndex], 0).r;
    // Preserve the +/-8 search span, 4-texel coarse lattice and +/-1 refinement.
    const int coarseRadius = 8, coarseStep = 4, refineRadius = 1;
    float bestCost = 1.0e20, secondCost = 1.0e20;
    ivec2 bestMotion = ivec2(0);
    int bestMotionDistanceSquared = 0x7fffffff;
    for (int dy = -coarseRadius; dy <= coarseRadius; dy += coarseStep)
        for (int dx = -coarseRadius; dx <= coarseRadius; dx += coarseStep)
            evaluateCandidate(ivec2(dx, dy), center, extent, currentPatch,
                bestCost, secondCost, bestMotion, bestMotionDistanceSquared);
    ivec2 coarseBestMotion = bestMotion;
    for (int dy = -refineRadius; dy <= refineRadius; ++dy)
        for (int dx = -refineRadius; dx <= refineRadius; ++dx) {
            ivec2 motion = coarseBestMotion + ivec2(dx, dy);
            if (all(equal(motion, coarseBestMotion))) continue;
            evaluateCandidate(motion, center, extent, currentPatch,
                bestCost, secondCost, bestMotion, bestMotionDistanceSquared);
        }
    if (bestCost >= 1.0e19) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    float confidence = clamp(
        (secondCost - bestCost) / max(secondCost, 1.0e-5), 0.0, 1.0);
    bool searchBoundary = any(greaterThanEqual(abs(bestMotion),
        ivec2(coarseRadius + refineRadius)));
    if (searchBoundary) confidence *= 0.05;
    imageStore(motionOutput, outPos,
        vec4(vec2(bestMotion), confidence, bestCost / 9.0));
}
