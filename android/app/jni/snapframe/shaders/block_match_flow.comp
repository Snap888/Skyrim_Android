#version 450

// Coarse-to-fine block-matching motion field over half-resolution luma.
// One output texel represents a configurable luma region. At 100% flow scale
// it is 8x8 luma texels; lower scales increase the stride and reduce the grid.
// Motion is expressed in half-resolution luma texels. The host runs this
// kernel twice with reversed inputs: current->previous, then previous->current.
// Confidence is local best/second-best SAD separation, not FB consistency.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D previousLuma;
layout(set = 0, binding = 1) uniform sampler2D currentLuma;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D motionOutput;

float lumaAt(sampler2D image, ivec2 p) {
    return texelFetch(image, p, 0).r;
}

void evaluateCandidate(
    ivec2 motion,
    ivec2 center,
    ivec2 extent,
    inout float bestCost,
    inout float secondCost,
    inout ivec2 bestMotion,
    inout int bestMotionDistanceSquared) {
    const int patchRadius = 1;
    float cost = 0.0;

    for (int py = -patchRadius; py <= patchRadius; ++py) {
        for (int px = -patchRadius; px <= patchRadius; ++px) {
            ivec2 samplePos = center + ivec2(px, py);
            ivec2 previousPos = samplePos + motion;
            if (any(lessThan(previousPos, ivec2(0))) ||
                any(greaterThanEqual(previousPos, extent)))
                return;

            cost += abs(lumaAt(currentLuma, samplePos) -
                        lumaAt(previousLuma, previousPos));
        }
    }

    int distanceSquared = motion.x * motion.x + motion.y * motion.y;
    if (cost < bestCost) {
        secondCost = bestCost;
        bestCost = cost;
        bestMotion = motion;
        bestMotionDistanceSquared = distanceSquared;
    } else if (cost == bestCost) {
        // Equal-cost matches are ambiguous. Prefer the smallest displacement
        // (zero motion wins on flat/low-texture blocks) and force zero margin.
        secondCost = bestCost;
        if (distanceSquared < bestMotionDistanceSquared) {
            bestMotion = motion;
            bestMotionDistanceSquared = distanceSquared;
        }
    } else if (cost < secondCost) {
        secondCost = cost;
    }
}

void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outExtent = imageSize(motionOutput);
    if (any(greaterThanEqual(outPos, outExtent)))
        return;

    ivec2 extent = textureSize(currentLuma, 0);
    if (any(lessThan(extent, ivec2(3)))) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    ivec2 blockStride = max(ivec2(1),
        ivec2(round(vec2(extent) / vec2(outExtent))));
    ivec2 center = min(outPos * blockStride + blockStride / 2,
                       extent - ivec2(2));

    // First search a +/-8 luma-texel window on a 2-texel lattice (9x9).
    // Refine the winning location with a 3x3 full-resolution neighborhood.
    // This expands the useful range to +/-9 while evaluating 90 candidates,
    // close to the old 81-candidate search cost.
    const int coarseRadius = 8;
    const int coarseStep = 2;

    float bestCost = 1.0e20;
    float secondCost = 1.0e20;
    ivec2 bestMotion = ivec2(0);
    int bestMotionDistanceSquared = 0x7fffffff;

    for (int dy = -coarseRadius; dy <= coarseRadius; dy += coarseStep) {
        for (int dx = -coarseRadius; dx <= coarseRadius; dx += coarseStep) {
            evaluateCandidate(ivec2(dx, dy), center, extent,
                bestCost, secondCost, bestMotion, bestMotionDistanceSquared);
        }
    }

    ivec2 coarseBestMotion = bestMotion;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 motion = coarseBestMotion + ivec2(dx, dy);
            if (all(equal(motion, coarseBestMotion)))
                continue;
            evaluateCandidate(motion, center, extent,
                bestCost, secondCost, bestMotion, bestMotionDistanceSquared);
        }
    }

    if (bestCost >= 1.0e19) {
        imageStore(motionOutput, outPos, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    float confidence = clamp(
        (secondCost - bestCost) / max(secondCost, 1.0e-5), 0.0, 1.0);
    imageStore(motionOutput, outPos,
        vec4(vec2(bestMotion), confidence, bestCost / 9.0));
}
