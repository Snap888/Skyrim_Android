#version 450

// Midpoint reconstruction from two real color frames and bidirectional flow.
// Flow vectors are measured in half-resolution luma texels. Motion fields are
// sampled with nearest-cell semantics: bilinear interpolation between coarse
// foreground/background vectors causes rubber geometry at moving silhouettes.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D previousColor;
layout(set = 0, binding = 1) uniform sampler2D currentColor;
layout(set = 0, binding = 2) uniform sampler2D currentToPrevious;
layout(set = 0, binding = 3) uniform sampler2D previousToCurrent;
layout(set = 0, binding = 4) uniform sampler2D consistencyMask;
layout(set = 0, binding = 5, rgba16f) writeonly uniform image2D midpointOutput;

ivec2 nearestFlowCell(vec2 uv, ivec2 flowExtent) {
    return clamp(ivec2(floor(uv * vec2(flowExtent))),
                 ivec2(0), flowExtent - ivec2(1));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(midpointOutput);
    if (any(greaterThanEqual(p, extent))) return;

    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(extent);
    ivec2 flowExtent = textureSize(currentToPrevious, 0);
    ivec2 flowCell = nearestFlowCell(uv, flowExtent);

    // Do not linearly mix vectors from adjacent blocks. At 50% flow scale one
    // cell spans ~32x32 source pixels, so the field is already coarse; keeping
    // each estimate intact is safer than blending motion across object edges.
    vec4 fwd = texelFetch(currentToPrevious, flowCell, 0);
    vec4 bwd = texelFetch(previousToCurrent, flowCell, 0);
    float consistency = texelFetch(consistencyMask, flowCell, 0).r;

    // A distinct best match is not sufficient evidence on animated/non-rigid
    // content, occlusions, motion blur or repeated textures. The matcher stores
    // normalized 3x3 SAD in alpha; reject large residuals before warping.
    float meanMatchCost = 0.5 * (fwd.w + bwd.w);
    float photometricConfidence =
        1.0 - smoothstep(0.035, 0.10, meanMatchCost);
    float confidence = clamp(min(fwd.z, bwd.z)
        * consistency * photometricConfidence, 0.0, 1.0);

    // Flow is expressed in half-resolution luma texels (one unit = two
    // full-resolution color pixels); reconstruct the temporal midpoint.
    vec2 pixelToUv = 2.0 / vec2(extent);
    vec2 previousUv = clamp(uv + fwd.xy * pixelToUv * 0.5,
                            vec2(0.0), vec2(1.0));
    vec2 currentUv = clamp(uv + bwd.xy * pixelToUv * 0.5,
                           vec2(0.0), vec2(1.0));

    vec4 prev = texture(previousColor, previousUv);
    vec4 curr = texture(currentColor, currentUv);
    vec4 warped = (prev + curr) * 0.5;
    vec4 fallback = (texture(previousColor, uv)
                   + texture(currentColor, uv)) * 0.5;

    // Raise the trust threshold: when local motion is ambiguous, prefer a
    // stable temporal blend over inventing a displacement and bending edges.
    float motionWeight = smoothstep(0.18, 0.70, confidence);
    imageStore(midpointOutput, p, mix(fallback, warped, motionWeight));
}
