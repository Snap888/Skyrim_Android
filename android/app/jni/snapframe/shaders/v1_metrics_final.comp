#version 450

// SnapFrame V1-compatible final reduction. Produces one frame-tagged scalar
// record in a storage buffer. Host copies only this record asynchronously.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct SnapFrameMetricsPartial {
    vec4 motion;
    vec4 quality;
};
layout(set = 0, binding = 0, std430) readonly buffer PartialBuffer {
    SnapFrameMetricsPartial values[];
} inputPartials;

struct SnapFrameMetricsResult {
    uvec4 identity; // frame ID low/high, timestamp ns low/high
    uvec4 extent;   // source width/height, flow width/height
    uvec4 flags;    // valid, partial count, expected cells, valid cells
    vec4 motion;    // mean magnitude, normalized complexity, mean confidence, low-confidence ratio
    vec4 quality;   // inconsistency ratio, boundary ratio, artifact-risk heuristic, valid coverage
    uvec4 debug;     // non-empty partials, min/max cells per partial, expected partials
};
layout(set = 0, binding = 1, std430) writeonly buffer ResultBuffer {
    SnapFrameMetricsResult value;
} outputResult;

layout(push_constant) uniform MetricsPush {
    uvec4 identity;
    uvec4 extent;
    uvec4 counts; // partial count, total flow cells, reserved, reserved
} pc;

shared vec4 sharedMotion[64];
shared vec4 sharedQuality[64];
shared uint sharedActivePartials[64];
shared uint sharedMinCells[64];
shared uint sharedMaxCells[64];

void main() {
    uint lane = gl_LocalInvocationIndex;
    vec4 motion = vec4(0.0);
    vec4 quality = vec4(0.0);
    uint activePartials = 0u;
    uint minCells = 0xffffffffu;
    uint maxCells = 0u;
    for (uint i = lane; i < pc.counts.x; i += 64u) {
        SnapFrameMetricsPartial partial = inputPartials.values[i];
        motion += partial.motion;
        quality += partial.quality;
        uint cells = uint(round(max(partial.quality.w, 0.0)));
        if (cells > 0u)
            activePartials++;
        minCells = min(minCells, cells);
        maxCells = max(maxCells, cells);
    }
    sharedMotion[lane] = motion;
    sharedQuality[lane] = quality;
    sharedActivePartials[lane] = activePartials;
    sharedMinCells[lane] = minCells;
    sharedMaxCells[lane] = maxCells;
    barrier();

    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            sharedMotion[lane] += sharedMotion[lane + stride];
            sharedQuality[lane] += sharedQuality[lane + stride];
            sharedActivePartials[lane] += sharedActivePartials[lane + stride];
            sharedMinCells[lane] = min(sharedMinCells[lane], sharedMinCells[lane + stride]);
            sharedMaxCells[lane] = max(sharedMaxCells[lane], sharedMaxCells[lane + stride]);
        }
        barrier();
    }

    if (lane == 0u) {
        float expectedCells = max(float(pc.counts.y), 1.0);
        float observedCells = max(quality.w, 0.0);
        float validCells = max(quality.z, 0.0);
        // Measure coverage against the cells the partial pass actually visited,
        // while separately requiring complete grid coverage. This distinguishes
        // invalid motion samples from a dispatch/grid-size mismatch.
        float validCoverage = validCells / max(observedCells, 1.0);
        bool gridComplete = abs(observedCells - expectedCells) < 0.5;
        bool valid = gridComplete && validCells > 0.0 && validCoverage >= 0.90;
        float divisor = max(validCells, 1.0);

        vec4 meanMotion = motion / divisor;
        vec4 meanQuality = quality / divisor;
        float artifactRisk = clamp(0.50 * meanMotion.w
                                  + 0.35 * meanQuality.x
                                  + 0.15 * meanQuality.y, 0.0, 1.0);

        outputResult.value.identity = pc.identity;
        outputResult.value.extent = pc.extent;
        outputResult.value.flags = uvec4(valid ? 1u : 0u,
                                         pc.counts.x, pc.counts.y, uint(round(validCells)));
        outputResult.value.motion = meanMotion;
        outputResult.value.quality = vec4(meanQuality.x, meanQuality.y,
                                          artifactRisk, validCoverage);
        outputResult.value.debug = uvec4(sharedActivePartials[0],
            sharedMinCells[0] == 0xffffffffu ? 0u : sharedMinCells[0],
            sharedMaxCells[0], pc.counts.x);
    }
}
